# Development image for the Base44 sandbox.
#
# It only provides the runtime and the external binaries this server spawns:
# ffmpeg/ffprobe, the fonts libass needs for SRT/ASS burn-in, and curl for the
# container healthcheck. Application source is bind-mounted, never copied.
FROM node:22

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
